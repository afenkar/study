.panel {
  background: #fffdf8;
  border: 1px solid #e4dccf;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.label {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.value {
  font-size: 32rpx;
  font-weight: 600;
}

.field {
  margin-bottom: 24rpx;
}

.input {
  background: #fffdf8;
  border: 1px solid #e4dccf;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
